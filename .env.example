# Required for default LLM (Together AI)
TOGETHER_API_KEY=your_together_api_key_here

# Optional – for other providers
# OPENAI_API_KEY=your_openai_key_here
# GROQ_API_KEY=your_groq_key_here
# GOOGLE_API_KEY=your_google_key_here

# Optional – Jev context harness. Shadow mode records a proposal without changing the prompt.
# uv sync --extra jev
# JEV_API_KEY=your_typesafe_api_key_here
# AGENTOI_CONTEXT_HARNESS=jev
# AGENTOI_CONTEXT_MODE=shadow

# Optional – Jev model routing and tool-risk gating. Both stay off unless set to jev.
# Query text and redacted tool arguments are sent to TypeSafe.
# AGENTOI_MODEL_ROUTING=jev
# AGENTOI_ROUTE_LOCAL=ollama:phi3
# AGENTOI_ROUTE_CAREFUL=deepseek-ai/DeepSeek-R1-Distill-Llama-70B
# AGENTOI_TOOL_GATE=jev
# AGENTOI_TOOL_RISK_THRESHOLD=0.5
# AGENTOI_GATED_TOOLS=search_term_context,search_knowledge_graph

# Optional – hosted experiment tracking after `uv run wandb login`
# AGENTOI_TRACKER=wandb
# WANDB_PROJECT=agentoi
# WANDB_ENTITY=your_team_or_account
